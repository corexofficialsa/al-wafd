rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Enquiry capture: any visitor can create a customer record (that's how
    // the site saves name+phone when someone clicks Enquire), but only the
    // signed-in admin can read, edit, or delete the list.
    match /customers/{doc} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // Visit/click counters: the public site increments these anonymously;
    // only the admin can read the totals.
    match /stats/{doc} {
      allow read: if request.auth != null;
      allow write: if true;
    }

    // Finance is admin-only end to end.
    match /expenses/{doc} {
      allow read, write: if request.auth != null;
    }
    match /income/{doc} {
      allow read, write: if request.auth != null;
    }
  }
}
